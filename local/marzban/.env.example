# Copy to .env before first run: cp .env.example .env
# This is a throwaway local panel for exercising marzban-sdk / marzban-mcp.
# Never reuse real/production Marzban credentials here.

SUDO_USERNAME=admin
SUDO_PASSWORD=changeme-local-only

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Self-signed cert, generated by `pnpm local:up` (gen-cert.sh) — required for
# Marzban to bind 0.0.0.0 at all inside its container, which in turn is
# required for Docker's port mapping below to reach it. See README.md
# "Ports". UVICORN_SSL_CA_TYPE=private is what tells Marzban a self-signed
# cert here is expected, not a misconfiguration.
UVICORN_SSL_CERTFILE=/var/lib/marzban/certs/local.crt
UVICORN_SSL_KEYFILE=/var/lib/marzban/certs/local.key
UVICORN_SSL_CA_TYPE=private

# Swagger/Redoc at /docs and /redoc — handy for poking the API by hand.
DOCS=True

# Host-side port the panel is published on (127.0.0.1 only). Change if 8000
# is taken on your machine.
MARZBAN_LOCAL_PORT=8000

# Leave DEBUG unset/False. In the published Docker image (unlike a source
# checkout) DEBUG=True makes the app shell out to `npm run dev` for the
# dashboard frontend on startup — npm isn't in this image, so the container
# crash-loops. DEBUG only works when running Marzban from source.
