{
  "name": "marzban-sdk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "types:check": "turbo run types:check",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "changelog:sdk": "git-cliff --tag sdk-v$(node -p \"require('./packages/sdk/package.json').version\") --tag-pattern '^(sdk-)?v[0-9].*' --include-path 'packages/sdk/**' --latest --prepend packages/sdk/CHANGELOG.md",
    "changelog:cli": "git-cliff --tag cli-v$(node -p \"require('./packages/cli/package.json').version\") --tag-pattern '^cli-v.*' --include-path 'packages/cli/**' --latest --prepend packages/cli/CHANGELOG.md",
    "changelog:mcp": "git-cliff --tag mcp-v$(node -p \"require('./packages/mcp/package.json').version\") --tag-pattern '^mcp-v.*' --include-path 'packages/mcp/**' --latest --prepend packages/mcp/CHANGELOG.md"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "git-cliff": "^2.13.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ilmar7786/marzban-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Ilmar7786/marzban-sdk/issues"
  },
  "homepage": "https://ilmar7786.github.io/marzban-sdk/"
}
