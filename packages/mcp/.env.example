# Copy to .env before local dev: cp .env.example .env
# .env is gitignored globally (root .gitignore) — never commit real credentials.
# See ARCHITECTURE.md "Local development & manual testing" for how this gets
# loaded — `node --env-file=.env`, not a shell `source`.

# Defaults below point at the disposable local/marzban panel (../../local/marzban)
# — swap for a real panel's URL/credentials if that's what you're testing against.
MARZBAN_BASE_URL=https://127.0.0.1:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=changeme-local-only

# local/marzban's cert is self-signed with no SAN — Node refuses it by
# default. Only ever set this against local/marzban; delete it the moment
# you point at a real panel.
NODE_TLS_REJECT_UNAUTHORIZED=0

# full unlocks destructive tools (delete, reset traffic, restart core) so
# there's something to exercise the confirm-token flow against. Only safe
# because local/marzban is throwaway — never against a real panel.
MARZBAN_MCP_PROFILE=full

# Optional — full reference: https://ilmar7786.github.io/marzban-sdk/docs/mcp-server/configuration
# MARZBAN_MCP_CONFIRM=off
# MARZBAN_MCP_LOG_LEVEL=debug
